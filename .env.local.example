# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored. NEVER commit the real service-role key: it bypasses
# RLS and can read the `reports` table, which has no public SELECT policy on purpose.

# Project → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Project → API → service_role. Server-only: note there is NO NEXT_PUBLIC_ prefix,
# which is what keeps it out of the browser. All DB access goes through /api/*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Project → API → anon / publishable key. Safe in the browser; used only by the
# Realtime subscription and sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Web Push. Generate a pair with:  npx web-push generate-vapid-keys
# The public key ships to the browser; the private key stays on the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
